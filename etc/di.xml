<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Open/closed seam: register the Google preset into admin-sso's registry. -->
    <type name="DmLab\AdminSso\Model\PresetRegistry">
        <arguments>
            <argument name="presets" xsi:type="array">
                <item name="google" xsi:type="object">DmLab\AdminSsoGoogle\Model\GooglePreset</item>
            </argument>
        </arguments>
    </type>
    <!-- Enforce the required Workspace domain (`hd`) and `email_verified` on Google logins,
         without touching the provider-agnostic core. -->
    <type name="DmLab\SsoCore\Model\Oidc\IdentityFactory">
        <plugin name="dmlab_admin_sso_google_enforce_hosted_domain"
                type="DmLab\AdminSsoGoogle\Plugin\EnforceHostedDomain"/>
    </type>
</config>
